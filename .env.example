# ==============================================================================
# GESTÃO 360 — Variáveis de Ambiente (Modelo)
# Copie para `.env.local` para desenvolvimento local.
# NUNCA versione `.env.local` nem exponha segredos com prefixo `VITE_`.
# ==============================================================================

# --- Frontend (Públicas — embutidas no bundle do navegador) ---
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-anon-key-publica-supabase"
VITE_SUPER_ADMIN_EMAIL="admin@prefeitura.gov.br"
VITE_GOOGLE_MAPS_API_KEY=""

# --- Backend Serverless / Edge (Vercel — SOMENTE SERVIDOR) ---
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_ANON_KEY="sua-anon-key-publica-supabase"
# ATENÇÃO: JAMAIS usar prefixo VITE_ nesta variável! Acesso total ao banco/Auth Admin.
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-somente-servidor"

# Chave da API Gemini (usada exclusivamente em api/* no servidor)
GEMINI_API_KEY="sua-chave-gemini-api"

# Origens CORS extras separadas por vírgula (ex.: domínio de homologação)
ALLOWED_ORIGINS="https://gestao360sistema.com.br"
# Slug do projeto na Vercel para permitir previews oficiais (*.vercel.app do próprio projeto)
VERCEL_PROJECT_SLUG="gestao-360"

# --- Testes de Integração RLS ao Vivo (Somente Staging — npm run test:rls-live) ---
RLS_TEST_URL=""
RLS_TEST_ANON_KEY=""
RLS_TEST_USER_A_EMAIL=""
RLS_TEST_USER_A_PASSWORD=""
RLS_TEST_USER_B_EMAIL=""
RLS_TEST_USER_B_PASSWORD=""
# Habilite =1 APENAS contra ambiente de staging (nunca produção)
RLS_TEST_ALLOW_WRITES="0"
